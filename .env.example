# ══════════════════════════════════════════════════════════════════════════════
# Ask OLake — environment configuration
# Copy to .env and fill in real values. NEVER commit .env (it's in .gitignore).
# ══════════════════════════════════════════════════════════════════════════════

# ── OpenRouter (REQUIRED) ─────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Models — these EXACT IDs are the only ones on this account:
GEN_MODEL=z-ai/glm-4.7-flash
FALLBACK_MODEL_1=google/gemini-2.5-flash-lite
FALLBACK_MODEL_2=deepseek/deepseek-v4.1-flash

# ── Cohere (OPTIONAL — trial key, opt-in) ─────────────────────────────────────
# COHERE_API_KEY=your_cohere_api_key_here
# Trial keys: limited calls/month. See README for trade-offs.
# WARNING: Trial keys are NOT licensed for production use.

# ── Embedding + Reranking providers ───────────────────────────────────────────
# "local"  = fastembed ONNX (BAAI/bge-small-en-v1.5) — default, free, baked in
# "cohere" = Cohere embed-english-v3.0 — better accuracy, uses quota
EMBED_PROVIDER=local

# "local"  = fastembed MiniLM cross-encoder — default, free, baked in
# "cohere" = Cohere rerank-v3.5 — better accuracy, uses quota
# "off"    = disable reranking entirely
RERANK_PROVIDER=local

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── Paths ────────────────────────────────────────────────────────────────────
DATA_DIR=./data
INDEX_DIR=./data/index

# ── Rate limiting (generous for judges) ──────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=16

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://olake.io

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_TOKEN=change_me_before_production

# ── RAG Tuning ──────────────────────────────────────────────────────────────
BM25_TOP_K=30
VECTOR_TOP_K=30
RERANK_TOP_K=6
CONFIDENCE_THRESHOLD=0.30
RERANK=on
ENABLE_SEMANTIC_CACHE=true
# Cache TTL: max 1h so answers never outlive the freshness window
CACHE_TTL_SECONDS=3600
MAX_QUESTION_LENGTH=1000
MAX_CONTEXT_TOKENS=3000
MAX_OUTPUT_TOKENS=500
LLM_TEMPERATURE=0.1

# ── Freshness (1-hour SLA) ────────────────────────────────────────────────────
# Background sync interval in minutes (default 30 → well within 1h SLA)
SYNC_INTERVAL_MIN=30
# /readyz marks degraded if last sync older than this (seconds)
FRESHNESS_DEGRADED_SECS=5400

# ── GitHub (optional, avoids rate limits during ingest) ───────────────────────
# GITHUB_TOKEN=ghp_...

# ── Budget guard ─────────────────────────────────────────────────────────────
BUDGET_DEGRADED_THRESHOLD=0.30
BUDGET_CHECK_INTERVAL_SECS=300
