{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "DATA_DIR": "data",
    "INDEX_DIR": "data/index",
    "EMBED_PROVIDER": "local",
    "RERANK_PROVIDER": "off",
    "RERANK": "off",
    "SYNC_INTERVAL_MIN": "99999"
  }
}
