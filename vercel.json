{
  "version": 2,
  "builds": [
    {
      "src": "app/server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/server.py"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "DATA_DIR": "/tmp/olake-data",
    "INDEX_DIR": "/tmp/olake-data/index"
  }
}
